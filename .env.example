# ---- 관리자(글 편집) 설정 ----
# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
#   Authorization callback URL: https://idbdyoung.com/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 로그인을 허용할 GitHub 계정 (이 계정만 관리자 페이지에 접근 가능)
ALLOWED_GITHUB_LOGIN=idbdyoung
# 글이 저장되는 저장소와 브랜치
GITHUB_REPO=idbdyoung/idbd-log
GITHUB_BRANCH=main
# 세션 쿠키 암호화 키 (openssl rand -base64 32)
SESSION_SECRET=
